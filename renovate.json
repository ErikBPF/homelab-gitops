{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ErikBPF/renovate-config"],
  "helmv3": {
    "managerFilePatterns": ["/(^|/)Chart\\.yaml$/"]
  },
  "packageRules": [
    {
      "description": "Keep GitHub Actions pinned to immutable commits",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Group platform Helm chart bumps into one PR per chart",
      "matchManagers": ["helmv3"],
      "matchFileNames": ["platform/**", "argocd/**"]
    },
    {
      "description": "Pin digests off — these are versioned Helm charts, not images",
      "matchManagers": ["helmv3"],
      "pinDigests": false
    }
  ]
}
