FROM docker.io/vllm/vllm-openai@sha256:91ee972ab751fb7180bc71c175865e36b091686600dca783d52b2511399810b3

# LMCache PR 4731: vLLM 0.30 packs attention K/V into rank-4 kernel pages.
COPY lmcache-packed-kv.patch /tmp/lmcache-packed-kv.patch
RUN patch --fuzz=0 -d /usr/local/lib/python3.12/dist-packages -p1 < /tmp/lmcache-packed-kv.patch \
    && rm /tmp/lmcache-packed-kv.patch
COPY apollo-packed-kv-layout.patch /tmp/apollo-packed-kv-layout.patch
RUN patch --fuzz=0 -d /usr/local/lib/python3.12/dist-packages -p1 < /tmp/apollo-packed-kv-layout.patch \
    && rm /tmp/apollo-packed-kv-layout.patch
