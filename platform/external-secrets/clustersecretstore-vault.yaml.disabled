// Re-enable when Vault@discovery is up: move back into templates/. See
// desktop-nixos RFC 2026-06-19 §5 (ESO -> Vault AppRole).
# Vault@discovery via AppRole. ESO calls Vault (egress: pod -> kepler NAT ->
# discovery:8200), so Vault needs no callback into the cluster.
apiVersion: external-secrets.io/v1beta1
kind: ClusterSecretStore
metadata:
  name: vault-discovery
  annotations:
    argocd.argoproj.io/sync-wave: "1" # after ESO's CRDs (wave 0)
spec:
  provider:
    vault:
      # Raw tailnet IP, not MagicDNS: ESO pods aren't tailnet members, so
      # "discovery" doesn't resolve in-cluster (same reason as the Alloy Loki URL).
      server: "https://100.76.140.121:8200"
      path: "secret"
      version: "v2"
      caProvider:
        type: ConfigMap
        name: vault-ca # TODO(erik): create with Vault's CA (cert SANs: IP + discovery)
        namespace: external-secrets
        key: ca.crt
      auth:
        appRole:
          path: "approle"
          roleId: "REPLACE_WITH_ROLE_ID" # non-secret; TODO(erik) fill after Vault setup
          secretRef:
            name: vault-approle # secret_id — seeded by sops-nix on kepler
            key: secret_id
            namespace: external-secrets
